{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quietkeep",
  "mainBinaryName": "quietkeep",
  "identifier": "dev.quietwire.quietkeep",
  "build": {
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../qk-ui",
      "wait": false
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../qk-ui"
    },
    "frontendDist": "../qk-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "QuietKeep",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Homelab patch and telemetry manager",
    "longDescription": "QuietKeep keeps a small to medium homelab patched and monitored from your desktop. It runs locally with no external server.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "admin",
        "priority": "optional",
        "desktopTemplate": "quietkeep.desktop",
        "files": {
          "/usr/share/metainfo/dev.quietwire.quietkeep.metainfo.xml": "dev.quietwire.quietkeep.metainfo.xml",
          "/usr/share/doc/quietkeep/copyright": "debian/copyright"
        }
      }
    },
    "publisher": "Dennis Ayotte",
    "copyright": "Copyright (C) 2026 Dennis Ayotte",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "homepage": "https://github.com/TheCaptainDumbass-TCD/QuietKeep"
  }
}
